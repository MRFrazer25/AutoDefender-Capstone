{
  "name": "AutoDefender",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt -r requirements-dev.txt",
  // The console needs AUTODEFENDER_UI_PASSWORD. In Codespaces, add it as a Codespaces secret
  // (GitHub Settings -> Codespaces -> Secrets) and it is set automatically. Keep the port private.
  "postAttachCommand": {
    "server": "streamlit run streamlit_app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "AutoDefender",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
