# Copy to .env (git-ignored) for docker compose. Use your own long random password.
AUTODEFENDER_UI_PASSWORD=replace-with-a-long-random-password

# Optional: the Ollama model for AI explanations (any model you've pulled; blank = built-in text)
# OLLAMA_MODEL=

# Optional settings
# AUTODEFENDER_BLOCK_HOURS=24
# AUTODEFENDER_RETENTION_DAYS=90
# SURICATA_ENABLED=true
# SURICATA_DRY_RUN=true
# AUTODEFENDER_GEOIP_CITY_DB=/data/GeoLite2-City.mmdb
# AUTODEFENDER_GEOIP_ASN_DB=/data/GeoLite2-ASN.mmdb
